# Sanity — public (safe for the browser / Vercel)
NEXT_PUBLIC_SANITY_PROJECT_ID=qu60lpod
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-19

# Sanity — server-only (never use NEXT_PUBLIC_ prefix)
# Dataset production is public: the Next.js app reads published catalog anonymously.
# Editor/write token for Studio mutations / one-off checks only (not used by the app client)
# SANITY_API_WRITE_TOKEN=

# Footer external links (optional — leave empty until real URLs are provided)
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_TELEGRAM=
# NEXT_PUBLIC_SOCIAL_VIBER=
# NEXT_PUBLIC_STUDIO_URL=
