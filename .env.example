# Sanity — public (safe for the browser / Vercel)
NEXT_PUBLIC_SANITY_PROJECT_ID=qu60lpod
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-19

# Same public IDs for standalone Studio Vite (`npm run studio`).
# Sanity CLI loads `.env` / `.env.local`; Vite exposes SANITY_STUDIO_* by default.
SANITY_STUDIO_PROJECT_ID=qu60lpod
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2025-08-19


# Sanity — server-only (never use NEXT_PUBLIC_ prefix)
# Dataset production is public: the Next.js app reads published catalog anonymously.
# Editor/write token for Studio mutations / one-off checks only (not used by the app client)
# SANITY_API_WRITE_TOKEN=

# Catalog demo products — explicit test mode only.
# Default when unset: disabled. Set true/1/on/yes to show placeholders
# when a category has zero published Sanity products.
# DEMO_CATALOG=true

# Optional overrides for messenger links (defaults live in lib/site-links.ts)
# NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/Vitaliia_11
# NEXT_PUBLIC_SOCIAL_VIBER=viber://chat?number=%2B380967422184

# Standalone Sanity Studio (Vite). Local: `npm run studio` → :3333
# Production: set after `npm run studio:deploy` (e.g. https://obriy.sanity.studio)
# Used by /studio → external redirect only (not the footer credit).
NEXT_PUBLIC_STUDIO_URL=http://localhost:3333

# Redient Web Studio — footer credit link. Leave unset to show plain text.
# NEXT_PUBLIC_RWS_URL=https://example.com

# Canonical site origin for SEO (metadataBase / sitemap / robots) and
# product Share / copy (no trailing slash).
# Production:
# NEXT_PUBLIC_SITE_URL=https://obriy.example.com
# Dev: if unset, SEO falls back to http://localhost:3000; Share on localhost
# rewrites to NEXT_PUBLIC_DEV_LAN_HOST from next.config (allowedDevOrigins[0]).
